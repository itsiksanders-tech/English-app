rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Maps a lowercase name to the account's internal auth email, so a
    // kid can log in with just their name. Publicly readable (there's
    // nothing sensitive in it), but a name can only ever be claimed
    // once, by the account that just created it.
    match /usernames/{key} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // A kid's profile and progress. Only the signed-in owner of this
    // uid can ever read or write it — this is what makes each account
    // actually private, not just password-gated in the browser.
    match /users/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
